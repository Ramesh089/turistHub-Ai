# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# SMTP email delivery (required for approved partner temporary passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=tourist_hub

# Partner documents and public listing images are stored in separate directories.
# Relative paths are resolved from the backend directory; use mounted durable storage in production.
PARTNER_DOCUMENT_DIR=uploads/partner-docs
LISTING_IMAGE_DIR=uploads/listing-images

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_min_32_characters_here_2026
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_here_2026

# AI Travel Planner & Guide API Keys (Optional - Free Google Gemini recommended)
# Get free Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Or OpenAI API Key:
OPENAI_API_KEY=
# Or Groq API Key:
GROQ_API_KEY=

# Weather API Key (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
